source leaprc.protein.ff14SB
source leaprc.GLYCAM_06j-1
source leaprc.water.tip3p
source leaprc.gaff2
loadamberparams ~/enz_md/build/P/resultados/calc/08_md/params_gt35/frcmod.frag_gaff2
